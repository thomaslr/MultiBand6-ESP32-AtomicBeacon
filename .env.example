# Copy this file to .env and set your Wi-Fi credentials
# .env is in .gitignore and will never be committed to Git

WIFI_SSID="Your_WiFi_SSID"
WIFI_PASSWORD="Your_WiFi_Password"

# Optional: Custom NTP server (default: pool.ntp.org)
# NTP_SERVER="pool.ntp.org"

# Optional: Antenna Output GPIO Pin (default: 2)
# Supported by ESP32-C3 LEDC PWM hardware peripheral
ANTENNA_PIN=2
