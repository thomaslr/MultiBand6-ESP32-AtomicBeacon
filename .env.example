# ==============================================================================
# MultiBand6-ESP32-AtomicBeacon Environment Configuration (.env)
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env':  cp .env.example .env
# 2. Edit values below for your home setup.
# 3. .env is in .gitignore and will never be committed to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Wi-Fi Network Credentials (Required for Automatic Boot Connection)
# ------------------------------------------------------------------------------
# If left blank, the ESP32 starts the "TimeStation-Setup" AP captive portal.
WIFI_SSID="Your_WiFi_SSID"
WIFI_PASSWORD="Your_WiFi_Password"

# ------------------------------------------------------------------------------
# 2. Hardware Pin Assignment
# ------------------------------------------------------------------------------
# Default antenna carrier output pin (ESP32-C3 LEDC Channel 0).
# Options: 2 (standard / SuperMini default), or any valid GPIO (e.g. 0, 1, 3, 4, 10).
ANTENNA_PIN=2

# ------------------------------------------------------------------------------
# 3. Default Time Signal Station
# ------------------------------------------------------------------------------
# Available stations:
#   0 = BPC   — China (Shangqiu)       - 68.5 kHz (20s frame)
#   1 = WWVB  — USA (Fort Collins, CO) - 60.0 kHz (60s frame)
#   2 = MSF   — UK (Anthorn, Cumbria)  - 60.0 kHz (60s frame)
#   3 = DCF77 — Germany (Mainflingen)  - 77.5 kHz (60s frame)
#   4 = JJY40 — Japan East (Fukushima) - 40.0 kHz (60s frame)
#   5 = JJY60 — Japan West (Kyushu)    - 60.0 kHz (60s frame)
DEFAULT_STATION=0

# ------------------------------------------------------------------------------
# 4. Custom Destination Time Offset (Hours)
# ------------------------------------------------------------------------------
# Manual adjustment relative to the station's native broadcast time:
#   0  = Exact native station local time
#  +8  = e.g. Sync a BPC watch in Perth (AWST UTC+8) or Singapore
#  -5  = e.g. Sync a WWVB watch in Eastern Standard Time (EST)
# Options: Integer between -12 and +12
DEFAULT_OFFSET_HOURS=0

# ------------------------------------------------------------------------------
# 5. Daily Broadcast Schedule Configuration
# ------------------------------------------------------------------------------
# Enable or disable the daily automatic broadcast schedule:
#   1 = Enabled (true)
#   0 = Disabled (false)
DEFAULT_SCHEDULE_ENABLED=1

# Daily broadcast start time (24-hour local time format):
#   DEFAULT_BROADCAST_HOUR   = 0 to 23 (e.g. 2 for 02:00 AM)
#   DEFAULT_BROADCAST_MINUTE = 0 to 59 (e.g. 0 for :00)
DEFAULT_BROADCAST_HOUR=2
DEFAULT_BROADCAST_MINUTE=0

# Duration of each daily broadcast in minutes:
#   Recommended: 15 to 30 minutes (most atomic watches sync within 3-7 minutes)
DEFAULT_BROADCAST_DURATION=25

# ------------------------------------------------------------------------------
# 6. NTP Time Server
# ------------------------------------------------------------------------------
# Network Time Protocol server used to discipline the internal RTC:
# Options: "pool.ntp.org", "time.google.com", "time.cloudflare.com", "time.windows.com"
NTP_SERVER="pool.ntp.org"
