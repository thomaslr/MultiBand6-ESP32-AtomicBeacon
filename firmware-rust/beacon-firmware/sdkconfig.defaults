# ESP32-C3 SuperMini Configuration Defaults

# Flash Size (ESP32-C3 SuperMini has 4MB SPI Flash)
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"

# CPU Frequency: 80 MHz low-power mode (halves core dynamic power, APB stable at 80 MHz)
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_80=y

# FreeRTOS 1000 Hz tick rate for 1ms precision
CONFIG_FREERTOS_HZ=1000

# Main Task Stack Size (Rust + Serde + Wi-Fi requires > 8KB)
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384

# Panic behavior: print backtrace and reboot
CONFIG_ESP_SYSTEM_PANIC_PRINT_REBOOT=y

# HTTP Server buffer limits for JSON payloads and concurrent LwIP sockets
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=512
CONFIG_LWIP_MAX_SOCKETS=18

# Watchdog timeout
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10

# Native USB Serial / JTAG console for ESP32-C3
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# Built-in Dual OTA Partition Table (2x 1984KB app slots for 4MB flash)
CONFIG_PARTITION_TABLE_TWO_OTA_LARGE=y

# Bootloader App Rollback (Failsafe recovery on panic/crash)
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# TLS Root Certificate Bundle for HTTPS downloads (GitHub Releases)
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_CMN=y
